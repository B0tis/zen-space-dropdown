    "label": "Enable Space Dropdown",
    "type": "checkbox",
    "defaultValue": true
  },
  {
    "property": "mod.space-dropdown.max_height",
    "label": "Ceiling for the expanded list height, columns are added past it (e.g. 80vh or 600px). Empty = 80vh",
    "type": "string",
    "defaultValue": "80vh",
    "placeholder": "80vh"
  },
  {
    "property": "mod.space-dropdown.show_names",
    "label": "Show Space names in expanded list",
    "type": "checkbox",
    "defaultValue": true
  },
  {
    "property": "mod.space-dropdown.chip_radius",
    "label": "Chip / row border radius (e.g. 8px)",
    "type": "string",
    "defaultValue": "8px",
    "placeholder": "8px"
  },
  {
    "property": "mod.space-dropdown.active_bg",
    "label": "Active Space background (hex/rgba)",
    "type": "string",
    "defaultValue": "color-mix(in srgb, AccentColor 28%, transparent)",
    "placeholder": "color-mix(in srgb, AccentColor 28%, transparent)"
  }
